{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://ai-stack.local/contracts/flow.schema.json",
  "title": "Flow",
  "description": "How several agents cooperate on one job. Engine-agnostic: an engine turns it into something runnable (kernel 0.4: a Claude Code skill).",
  "type": "object",
  "allOf": [{ "$ref": "module.schema.json" }],
  "required": ["description", "steps"],
  "properties": {
    "kind": { "const": "flow" },
    "argument_hint": { "type": "string", "description": "Shown next to the command, e.g. \"[target]\"." },
    "input": {
      "type": "object",
      "description": "What the flow input ($input) means.",
      "properties": {
        "description": { "type": "string" },
        "default": { "type": "string", "description": "Used when the user gives no input." }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "if": { "type": "object", "required": ["loop"] },
        "then": { "$ref": "#/$defs/loopStep" },
        "else": { "$ref": "#/$defs/agentStep" }
      }
    },
    "report": { "type": "string", "description": "What the final report to the user contains." }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "ref": {
      "type": "string",
      "pattern": "^\\$(input|[a-z][a-z0-9-]*)(\\.(output(\\.[a-z_][a-z0-9_]*)*|findings|artifacts|questions|summary|checks))?$"
    },
    "condition": {
      "type": "object",
      "required": ["step", "is"],
      "properties": {
        "step": { "type": "string" },
        "is": { "enum": ["has-findings", "has-major-findings", "no-findings", "no-major-findings", "has-questions"] }
      },
      "additionalProperties": false
    },
    "gate": { "enum": ["auto", "human", "on-questions"], "default": "auto", "description": "auto = continue; human = wait for approval; on-questions = wait only when there are questions." },
    "agentStep": {
      "type": "object",
      "required": ["id", "goal"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "agent": { "type": "string", "description": "Role or role-variant id, without the prefix (e.g. verifier-security)." },
        "fanout": { "type": "array", "minItems": 2, "items": { "type": "string" }, "description": "Agents run in parallel on the same inputs." },
        "foreach": { "$ref": "#/$defs/ref", "description": "With `agent`: run it once per item of this list (e.g. $plan.output.units), in waves by the items' depends_on, in parallel when items share no files." },
        "goal": { "type": "string", "description": "The task goal handed to the agent(s)." },
        "in": {
          "type": "object",
          "description": "Inputs: a reference ($input, $<step>, $<step>.<field>), a list of references meaning 'the most recent available', or literal text.",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/ref" } }
            ]
          }
        },
        "when": { "$ref": "#/$defs/condition", "description": "Run the step only if an earlier step's handoffs meet the condition." },
        "gate": { "$ref": "#/$defs/gate" }
      },
      "oneOf": [{ "required": ["agent"] }, { "required": ["fanout"] }],
      "dependentSchemas": { "foreach": { "required": ["agent"] } },
      "additionalProperties": false
    },
    "loopStep": {
      "type": "object",
      "required": ["id", "loop"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "loop": {
          "type": "object",
          "required": ["max", "until", "steps"],
          "properties": {
            "max": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Maximum number of iterations." },
            "until": { "$ref": "#/$defs/condition", "description": "Checked after each iteration on a step of the loop body; the loop stops once it holds." },
            "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/agentStep" }, "description": "Run in order on every iteration; loops do not nest." }
          },
          "additionalProperties": false
        },
        "when": { "$ref": "#/$defs/condition" },
        "gate": { "$ref": "#/$defs/gate" }
      },
      "additionalProperties": false
    }
  }
}
